# Database — Neon (https://console.neon.tech → your project → Connection Details)
# Use the "pooled" connection string for the app, direct for migrations
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/dbname?ssl=require
DATABASE_URL_SYNC=postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# JWT
SECRET_KEY=your-super-secret-key-minimum-32-characters-long
ALGORITHM=HS256

# AI Provider — GROQ (https://console.groq.com → API Keys)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your-groq-api-key-here
# Available models: llama-3.3-70b-versatile | llama-3.1-8b-instant | mixtral-8x7b-32768 | gemma2-9b-it
LLM_MODEL=llama-3.3-70b-versatile

# Storage
UPLOAD_DIR=./uploads
FAISS_INDEX_PATH=./data/faiss_index

# Redis (optional caching)
REDIS_URL=redis://localhost:6379

# App
DEBUG=true
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:3000"]
